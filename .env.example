# Copia este archivo a .env.local y completa los valores. Nunca subas .env.local.

# Postgres: la MISMA base de sistema-evaluaciones, pero el schema "ejercicio".
# El schema va en ?schema= y la app lo aplica como search_path.
# Agrega &sslmode=require si el servidor exige SSL.
DATABASE_URL=postgresql://usuario:contraseña@host:5432/basedatos?schema=ejercicio

# Firma HMAC de la cookie de sesión (mínimo 32 caracteres). Usa una distinta a
# la de sistema-evaluaciones. Para generarla:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Cambiarla cierra todas las sesiones abiertas.
SESSION_SECRET=

# OpenAI: UNA llamada por entrega (estudiante y día): escribe la
# retroalimentación del día y, en la G1, califica la pregunta abierta.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Opcional, solo para pruebas: otra URL compatible (un servidor simulado).
# OPENAI_BASE_URL=http://127.0.0.1:2626/v1

# Subir los audios desde el panel a Vercel Blob, igual que en evaluaciones. No se
# escribe a mano: Vercel la agrega al conectar el Blob store al proyecto (el
# mismo store de evaluaciones sirve). Vacía, el audio solo se agrega pegando el
# enlace de un archivo ya publicado.
BLOB_READ_WRITE_TOKEN=
